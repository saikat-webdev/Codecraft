APP_NAME=CodeCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=codecraft_db
DB_USERNAME=codecraft
DB_PASSWORD=codecraft_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

JUDGE0_ENABLED=true
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_TIMEOUT=30

# n8n AI Instructor webhook (full URL from n8n Webhook node)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-teacher
N8N_WEBHOOK_TIMEOUT=90

# Gemini chat + embeddings (RAG). Same key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PREFER_N8N=false
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# AI knowledge base (pgvector) — run: php artisan knowledge:embed --fresh
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.35
