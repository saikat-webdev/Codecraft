APP_NAME=CodeCraft
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=codecraft_db
DB_USERNAME=codecraft
DB_PASSWORD=codecraft_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

JUDGE0_ENABLED=true
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_TIMEOUT=30

# n8n AI Instructor webhook (full URL from n8n Webhook node)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-teacher
N8N_WEBHOOK_TIMEOUT=90

# Optional: used when n8n fails or returns empty (same key as Google AI Studio)
GEMINI_API_KEY=
# Change model here (HTTP node in n8n uses the same id in its URL path)
GEMINI_MODEL=gemini-3.5-flash
