# Copy into backend/.env when using Supabase.
# Windows/XAMPP: use SESSION POOLER (IPv4) — NOT db.*.supabase.co (often IPv6-only → "Unknown host")
# Supabase Dashboard → Connect → Session mode

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# Or Session pooler URI:
# DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# AI uses Gemini directly by default. Set AI_PREFER_N8N=true only if n8n is working.
AI_PREFER_N8N=false
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.35

N8N_WEBHOOK_URL=https://your-n8n.app/webhook/ai-teacher
N8N_WEBHOOK_TIMEOUT=90
